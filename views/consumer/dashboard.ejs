<!-- ==========================================================================
     views/consumer/dashboard.ejs — Consumer Dashboard
     ==========================================================================
     Consumer's main view with current bill card, summary stats, and
     a consumption history chart.
     ========================================================================== -->

<%- include('../partials/header') %>

<!-- Page Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-white">My Dashboard</h1>
  <p class="text-gray-400 mt-1">Welcome back, <%= currentUser.name %></p>
</div>

<!-- ==========================================================================
     Summary Stat Cards
     ========================================================================== -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-5">
    <p class="text-sm text-gray-400 mb-1">Total Bills</p>
    <p class="text-2xl font-bold text-white"><%= totalBills %></p>
  </div>
  <div class="card-hover bg-surface-800/60 backdrop-blur border border-emerald-800/20 rounded-2xl p-5">
    <p class="text-sm text-gray-400 mb-1">Paid</p>
    <p class="text-2xl font-bold text-emerald-400"><%= paidBills %></p>
  </div>
  <div class="card-hover bg-surface-800/60 backdrop-blur border border-amber-800/20 rounded-2xl p-5">
    <p class="text-sm text-gray-400 mb-1">Pending / Overdue</p>
    <p class="text-2xl font-bold text-amber-400"><%= pendingBills %></p>
  </div>
  <div class="card-hover bg-surface-800/60 backdrop-blur border border-accent-800/20 rounded-2xl p-5">
    <p class="text-sm text-gray-400 mb-1">Total Paid</p>
    <p class="text-2xl font-bold text-accent-400">₹<%= totalPaid.toLocaleString() %></p>
  </div>
</div>

<!-- ==========================================================================
     Current Bill + Meter Info
     ========================================================================== -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Current Bill Card -->
  <div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Latest Bill</h2>

    <% if (!currentBill) { %>
      <div class="text-center py-10">
        <svg class="w-12 h-12 text-gray-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <p class="text-gray-500">No bills generated yet.</p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Billing Period</span>
          <span class="text-white font-medium"><%= currentBill.billingPeriod.month %>/<%= currentBill.billingPeriod.year %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Meter</span>
          <span class="text-primary-300 font-mono"><%= currentBill.meter ? currentBill.meter.meterNumber : '—' %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Units Consumed</span>
          <span class="text-amber-400 font-semibold"><%= currentBill.unitsConsumed %> kWh</span>
        </div>

        <div class="border-t border-primary-800/20 pt-3 mt-3">
          <div class="flex justify-between">
            <span class="text-gray-400">Total Amount</span>
            <span class="text-2xl font-bold text-white">₹<%= currentBill.totalAmount.toLocaleString() %></span>
          </div>
          <% if (currentBill.surcharge > 0) { %>
            <p class="text-xs text-red-400 text-right mt-1">Includes ₹<%= currentBill.surcharge %> surcharge</p>
          <% } %>
        </div>

        <div class="flex justify-between items-center pt-2">
          <span class="text-xs font-medium px-2 py-1 rounded-full
            <%= currentBill.status === 'paid' ? 'bg-emerald-500/10 text-emerald-400' : currentBill.status === 'overdue' ? 'bg-red-500/10 text-red-400' : 'bg-amber-500/10 text-amber-400' %>
          "><%= currentBill.status.toUpperCase() %></span>
          <span class="text-xs text-gray-500">Due: <%= new Date(currentBill.dueDate).toLocaleDateString() %></span>
        </div>

        <div class="pt-3 flex space-x-3">
          <a href="/consumer/bills/<%= currentBill._id %>" class="flex-1 text-center py-2.5 bg-primary-500/10 text-primary-400 font-medium rounded-xl hover:bg-primary-500/20 transition-all text-sm">
            View Details
          </a>
          <% if (currentBill.status !== 'paid') { %>
            <form action="/consumer/bills/<%= currentBill._id %>/pay" method="POST" class="flex-1">
              <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-medium rounded-xl hover:from-emerald-500 hover:to-emerald-400 transition-all text-sm shadow-lg shadow-emerald-500/25">
                Pay Now
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Meter Info Card -->
  <div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">My Meter</h2>

    <% if (!meter) { %>
      <div class="text-center py-10">
        <p class="text-gray-500">No meter assigned yet.</p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Meter Number</span>
          <span class="text-primary-300 font-mono"><%= meter.meterNumber %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Status</span>
          <span class="text-xs font-medium px-2 py-1 rounded-full bg-emerald-500/10 text-emerald-400"><%= meter.status %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Current Reading</span>
          <span class="text-lg font-bold text-amber-400"><%= meter.lastReading %> kWh</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">Installed</span>
          <span class="text-gray-300"><%= new Date(meter.installationDate).toLocaleDateString() %></span>
        </div>
      </div>
    <% } %>

    <!-- Consumption Chart -->
    <% if (consumptionHistory.length > 0) { %>
      <div class="mt-6 pt-4 border-t border-primary-800/20">
        <h3 class="text-sm font-medium text-gray-400 mb-3">Consumption Trend</h3>
        <div class="h-48">
          <canvas id="consumptionChart"></canvas>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- Quick Links -->
<div class="flex space-x-4">
  <a href="/consumer/bills" class="px-6 py-3 bg-surface-800/60 border border-primary-800/20 rounded-xl text-gray-300 hover:text-white hover:bg-primary-900/40 transition-all font-medium">
    View All Bills →
  </a>
</div>

<% if (typeof consumptionHistory !== 'undefined' && consumptionHistory.length > 0) { %>
<script>
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const history = <%- JSON.stringify(consumptionHistory) %>;

  const ctx = document.getElementById('consumptionChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: history.map(h => monthNames[h.billingPeriod.month - 1] + ' ' + h.billingPeriod.year),
      datasets: [{
        label: 'Units (kWh)',
        data: history.map(h => h.unitsConsumed),
        borderColor: '#6366f1',
        backgroundColor: 'rgba(99, 102, 241, 0.1)',
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#6366f1',
        pointBorderColor: '#fff',
        pointBorderWidth: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { ticks: { color: '#6b7280', font: { size: 10 } }, grid: { display: false } },
        y: { ticks: { color: '#6b7280' }, grid: { color: 'rgba(99, 102, 241, 0.1)' } }
      },
      plugins: {
        legend: { display: false }
      }
    }
  });
</script>
<% } %>

<%- include('../partials/footer') %>
