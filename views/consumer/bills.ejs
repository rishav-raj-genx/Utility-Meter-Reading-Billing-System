<!-- ==========================================================================
     views/consumer/bills.ejs — Bill History
     ==========================================================================
     Lists all bills for the consumer with status indicators and links.
     ========================================================================== -->

<%- include('../partials/header') %>

<!-- Page Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-white">Bill History</h1>
  <p class="text-gray-400 mt-1">View all your past and current bills</p>
</div>

<!-- Bills Table -->
<div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl overflow-hidden">
  <% if (bills.length === 0) { %>
    <div class="text-center py-16">
      <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <p class="text-gray-500">No bills found.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-surface-900/40">
          <tr>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Period</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Meter</th>
            <th class="text-right py-3 px-5 text-sm font-medium text-gray-400">Units</th>
            <th class="text-right py-3 px-5 text-sm font-medium text-gray-400">Amount</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Status</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Due Date</th>
            <th class="text-right py-3 px-5 text-sm font-medium text-gray-400">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bills.forEach(bill => { %>
            <tr class="table-row-hover border-t border-primary-800/10">
              <td class="py-3 px-5 text-white font-medium"><%= bill.billingPeriod.month %>/<%= bill.billingPeriod.year %></td>
              <td class="py-3 px-5">
                <span class="text-sm font-mono text-primary-300"><%= bill.meter ? bill.meter.meterNumber : '—' %></span>
              </td>
              <td class="py-3 px-5 text-right text-amber-400 font-semibold"><%= bill.unitsConsumed %> kWh</td>
              <td class="py-3 px-5 text-right text-white font-semibold">₹<%= bill.totalAmount.toLocaleString() %></td>
              <td class="py-3 px-5">
                <span class="text-xs font-medium px-2 py-1 rounded-full
                  <%= bill.status === 'paid' ? 'bg-emerald-500/10 text-emerald-400' : bill.status === 'overdue' ? 'bg-red-500/10 text-red-400' : 'bg-amber-500/10 text-amber-400' %>
                "><%= bill.status.toUpperCase() %></span>
              </td>
              <td class="py-3 px-5 text-sm text-gray-400"><%= new Date(bill.dueDate).toLocaleDateString() %></td>
              <td class="py-3 px-5 text-right">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/consumer/bills/<%= bill._id %>" class="px-3 py-1.5 text-xs font-medium bg-primary-500/10 text-primary-400 rounded-lg hover:bg-primary-500/20 transition-all">View</a>
                  <% if (bill.status !== 'paid') { %>
                    <form action="/consumer/bills/<%= bill._id %>/pay" method="POST">
                      <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-emerald-500/10 text-emerald-400 rounded-lg hover:bg-emerald-500/20 transition-all">Pay</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
