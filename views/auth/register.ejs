<!-- ==========================================================================
     views/auth/register.ejs — Registration Page
     ========================================================================== -->

<%- include('../partials/header') %>

<div class="flex items-center justify-center min-h-[70vh]">
  <div class="w-full max-w-md">
    <!-- Card -->
    <div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-8 shadow-xl">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-primary-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white">Create Account</h1>
        <p class="text-gray-400 mt-1">Join the utility billing system</p>
      </div>

      <!-- Registration Form -->
      <form action="/auth/register" method="POST" class="space-y-5" id="register-form">
        <!-- Name -->
        <div>
          <label for="name" class="block text-sm font-medium text-gray-300 mb-1.5">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="John Doe"
            class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all"
          />
        </div>

        <!-- Role Selector -->
        <div>
          <label for="role" class="block text-sm font-medium text-gray-300 mb-1.5">Account Type</label>
          <select
            id="role"
            name="role"
            class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all appearance-none"
          >
            <option value="consumer">Consumer</option>
            <option value="meter_reader">Meter Reader</option>
            <option value="admin">Admin</option>
          </select>
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="block text-sm font-medium text-gray-300 mb-1.5">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all"
          />
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-1.5">Confirm Password</label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          id="register-btn"
          class="w-full py-3 bg-gradient-to-r from-emerald-600 to-primary-600 text-white font-semibold rounded-xl hover:from-emerald-500 hover:to-primary-500 transition-all shadow-lg shadow-emerald-500/25 focus:ring-2 focus:ring-primary-500/50"
        >
          Create Account
        </button>
      </form>

      <!-- Login link -->
      <p class="text-center text-sm text-gray-400 mt-6">
        Already have an account?
        <a href="/auth/login" class="text-primary-400 hover:text-primary-300 font-medium transition-colors">Sign in</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
