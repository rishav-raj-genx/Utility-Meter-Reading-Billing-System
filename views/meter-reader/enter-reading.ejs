<!-- ==========================================================================
     views/meter-reader/enter-reading.ejs — Enter Meter Reading Form
     ==========================================================================
     Form for entering a new meter reading. Shows the previous reading and
     validates that the new reading is not lower.
     ========================================================================== -->

<%- include('../partials/header') %>

<div class="max-w-lg mx-auto">
  <!-- Back Link -->
  <a href="/meter-reader/meters" class="inline-flex items-center text-sm text-gray-400 hover:text-primary-400 transition-colors mb-6">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to Meters
  </a>

  <!-- Reading Entry Card -->
  <div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-8">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-primary-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Enter Meter Reading</h1>
      <p class="text-gray-400 mt-1">Meter: <span class="text-primary-300 font-mono"><%= meter.meterNumber %></span></p>
    </div>

    <!-- Meter Info Summary -->
    <div class="bg-surface-900/40 rounded-xl p-4 mb-6 space-y-2">
      <div class="flex justify-between text-sm">
        <span class="text-gray-400">Consumer</span>
        <span class="text-white font-medium"><%= meter.consumer ? meter.consumer.name : '—' %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-400">Consumer ID</span>
        <span class="text-gray-300"><%= meter.consumer ? meter.consumer.consumerId : '—' %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-400">Previous Reading</span>
        <span class="text-amber-400 font-bold text-lg"><%= meter.lastReading %> kWh</span>
      </div>
    </div>

    <!-- Warning Notice -->
    <div class="bg-amber-500/10 border border-amber-500/20 text-amber-300 px-4 py-3 rounded-xl text-sm mb-6 flex items-start space-x-2">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      <span>New reading must be <strong>equal to or greater than</strong> the previous reading (<%= meter.lastReading %> kWh). Lower values will be rejected.</span>
    </div>

    <!-- Reading Entry Form -->
    <form action="/meter-reader/meters/<%= meter._id %>/reading" method="POST" class="space-y-5" id="reading-form">
      <div>
        <label for="reading" class="block text-sm font-medium text-gray-300 mb-1.5">New Reading (kWh)</label>
        <input
          type="number"
          id="reading"
          name="reading"
          required
          min="<%= meter.lastReading %>"
          step="1"
          placeholder="Enter current meter reading"
          class="w-full px-4 py-3 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white text-lg font-semibold placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all"
        />
      </div>

      <!-- Live units preview -->
      <div id="unitsPreview" class="hidden bg-primary-500/10 border border-primary-500/20 rounded-xl p-4 text-center">
        <p class="text-sm text-gray-400">Units to be billed</p>
        <p class="text-3xl font-bold text-primary-400" id="unitsValue">0</p>
        <p class="text-xs text-gray-500">kWh</p>
      </div>

      <button
        type="submit"
        class="w-full py-3 bg-gradient-to-r from-amber-600 to-primary-600 text-white font-semibold rounded-xl hover:from-amber-500 hover:to-primary-500 transition-all shadow-lg shadow-amber-500/25"
      >
        Submit Reading & Generate Bill
      </button>
    </form>
  </div>
</div>

<!-- Live units preview script -->
<script>
  const readingInput = document.getElementById('reading');
  const preview = document.getElementById('unitsPreview');
  const unitsValue = document.getElementById('unitsValue');
  const lastReading = <%= meter.lastReading %>;

  readingInput.addEventListener('input', () => {
    const val = Number(readingInput.value);
    if (val >= lastReading && readingInput.value !== '') {
      preview.classList.remove('hidden');
      unitsValue.textContent = (val - lastReading).toLocaleString();
    } else {
      preview.classList.add('hidden');
    }
  });
</script>

<%- include('../partials/footer') %>
