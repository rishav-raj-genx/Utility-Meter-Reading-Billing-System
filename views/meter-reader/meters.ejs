<!-- ==========================================================================
     views/meter-reader/meters.ejs — Meter Reader: Meter List
     ==========================================================================
     Lists all active meters available for reading entry. Shows consumer info,
     last reading, and a button to enter a new reading.
     ========================================================================== -->

<%- include('../partials/header') %>

<!-- Page Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-white">Meters to Read</h1>
  <p class="text-gray-400 mt-1">Select a meter to enter a monthly reading</p>
</div>

<!-- Meters Grid -->
<% if (meters.length === 0) { %>
  <div class="text-center py-20">
    <svg class="w-20 h-20 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
    <p class="text-gray-500 text-lg">No active meters found.</p>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% meters.forEach(meter => { %>
      <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6">
        <!-- Meter Number Badge -->
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-mono text-primary-300 bg-primary-500/10 px-3 py-1 rounded-lg"><%= meter.meterNumber %></span>
          <span class="w-3 h-3 bg-emerald-400 rounded-full animate-pulse" title="Active"></span>
        </div>

        <!-- Consumer Info -->
        <h3 class="text-lg font-semibold text-white mb-1"><%= meter.consumer ? meter.consumer.name : 'Unknown' %></h3>
        <p class="text-sm text-gray-400 mb-4">ID: <%= meter.consumer ? meter.consumer.consumerId : '—' %></p>

        <!-- Last Reading -->
        <div class="flex items-center justify-between py-3 px-4 bg-surface-900/40 rounded-xl mb-4">
          <span class="text-sm text-gray-400">Last Reading</span>
          <span class="text-lg font-bold text-amber-400"><%= meter.lastReading %> <span class="text-sm font-normal text-gray-500">kWh</span></span>
        </div>

        <!-- Enter Reading Button -->
        <a
          href="/meter-reader/meters/<%= meter._id %>/reading"
          class="block text-center py-2.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg shadow-primary-500/25"
        >
          Enter Reading
        </a>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
