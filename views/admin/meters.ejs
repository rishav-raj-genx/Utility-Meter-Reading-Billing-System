<!-- ==========================================================================
     views/admin/meters.ejs — Meter Management Page
     ==========================================================================
     CRUD interface for managing electricity meters. Admins can add new meters
     and assign them to consumers, or delete existing ones.
     ========================================================================== -->

<%- include('../partials/header') %>

<!-- Page Header -->
<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white">Manage Meters</h1>
    <p class="text-gray-400 mt-1">Create and manage electricity meters</p>
  </div>
  <button
    onclick="document.getElementById('addMeterModal').classList.remove('hidden')"
    class="px-5 py-2.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg shadow-primary-500/25 flex items-center space-x-2"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
    <span>Add Meter</span>
  </button>
</div>

<!-- Meters Table -->
<div class="bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl overflow-hidden">
  <% if (meters.length === 0) { %>
    <div class="text-center py-16">
      <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
      <p class="text-gray-500">No meters found. Add your first meter.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-surface-900/40">
          <tr>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Meter Number</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Consumer</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Consumer ID</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Status</th>
            <th class="text-right py-3 px-5 text-sm font-medium text-gray-400">Last Reading</th>
            <th class="text-left py-3 px-5 text-sm font-medium text-gray-400">Installed</th>
            <th class="text-right py-3 px-5 text-sm font-medium text-gray-400">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% meters.forEach(meter => { %>
            <tr class="table-row-hover border-t border-primary-800/10">
              <td class="py-3 px-5">
                <span class="text-sm font-mono text-primary-300 bg-primary-500/10 px-2 py-0.5 rounded"><%= meter.meterNumber %></span>
              </td>
              <td class="py-3 px-5 text-white font-medium"><%= meter.consumer ? meter.consumer.name : '—' %></td>
              <td class="py-3 px-5 text-gray-400 text-sm"><%= meter.consumer ? meter.consumer.consumerId : '—' %></td>
              <td class="py-3 px-5">
                <span class="text-xs font-medium px-2 py-1 rounded-full <%= meter.status === 'active' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400' %>">
                  <%= meter.status %>
                </span>
              </td>
              <td class="py-3 px-5 text-right text-amber-400 font-semibold"><%= meter.lastReading %> kWh</td>
              <td class="py-3 px-5 text-gray-400 text-sm"><%= new Date(meter.installationDate).toLocaleDateString() %></td>
              <td class="py-3 px-5 text-right">
                <form action="/admin/meters/<%= meter._id %>/delete" method="POST" onsubmit="return confirm('Delete this meter?')">
                  <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-red-500/10 text-red-400 rounded-lg hover:bg-red-500/20 transition-all">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ==========================================================================
     Add Meter Modal
     ========================================================================== -->
<div id="addMeterModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-surface-800 border border-primary-800/30 rounded-2xl p-8 w-full max-w-md shadow-2xl">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white">Add New Meter</h2>
      <button onclick="document.getElementById('addMeterModal').classList.add('hidden')" class="text-gray-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form action="/admin/meters" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Meter Number</label>
        <input type="text" name="meterNumber" required placeholder="e.g., MTR-001" class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Assign to Consumer</label>
        <select name="consumer" required class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50">
          <option value="">— Select Consumer —</option>
          <% consumers.forEach(c => { %>
            <option value="<%= c._id %>"><%= c.name %> (<%= c.consumerId || c.email %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">Installation Date</label>
        <input type="date" name="installationDate" class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
      </div>

      <button type="submit" class="w-full py-3 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg">
        Create Meter
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
