<!-- ==========================================================================
     views/admin/tariffs.ejs — Tariff Slab Management Page
     ==========================================================================
     Interface for managing tariff slabs with dynamic slab tier rows.
     ========================================================================== -->

<%- include('../partials/header') %>

<!-- Page Header -->
<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white">Manage Tariff Slabs</h1>
    <p class="text-gray-400 mt-1">Configure billing rate tiers for different connection types</p>
  </div>
  <button
    onclick="document.getElementById('addTariffModal').classList.remove('hidden')"
    class="px-5 py-2.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg shadow-primary-500/25 flex items-center space-x-2"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
    <span>Add Tariff Slab</span>
  </button>
</div>

<!-- Tariff Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if (tariffs.length === 0) { %>
    <div class="col-span-full text-center py-16">
      <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      <p class="text-gray-500">No tariff slabs found. Create one to get started.</p>
    </div>
  <% } else { %>
    <% tariffs.forEach(tariff => { %>
      <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6">
        <!-- Tariff Header -->
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-white"><%= tariff.name %></h3>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full mt-1 inline-block
              <%= tariff.connectionType === 'domestic' ? 'bg-emerald-500/10 text-emerald-400' : tariff.connectionType === 'commercial' ? 'bg-amber-500/10 text-amber-400' : 'bg-red-500/10 text-red-400' %>
            "><%= tariff.connectionType %></span>
          </div>
          <form action="/admin/tariffs/<%= tariff._id %>/delete" method="POST" onsubmit="return confirm('Delete this tariff?')">
            <button type="submit" class="p-2 bg-red-500/10 text-red-400 rounded-lg hover:bg-red-500/20 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </form>
        </div>

        <!-- Slab Tiers -->
        <div class="space-y-2 mb-4">
          <% tariff.slabs.forEach(tier => { %>
            <div class="flex items-center justify-between py-2 px-3 bg-surface-900/40 rounded-lg text-sm">
              <span class="text-gray-400"><%= tier.minUnit %>–<%= tier.maxUnit %> units</span>
              <span class="text-primary-400 font-semibold">₹<%= tier.ratePerUnit %>/unit</span>
            </div>
          <% }) %>
        </div>

        <!-- Fixed Charge & Surcharge -->
        <div class="flex items-center justify-between pt-3 border-t border-primary-800/20 text-sm">
          <span class="text-gray-400">Fixed Charge</span>
          <span class="text-white font-semibold">₹<%= tariff.fixedCharge %></span>
        </div>
        <div class="flex items-center justify-between mt-1 text-sm">
          <span class="text-gray-400">Late Surcharge</span>
          <span class="text-amber-400 font-semibold"><%= tariff.surchargePercent %>%</span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<!-- ==========================================================================
     Add Tariff Modal (with dynamic slab tier rows)
     ========================================================================== -->
<div id="addTariffModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-surface-800 border border-primary-800/30 rounded-2xl p-8 w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white">Add Tariff Slab</h2>
      <button onclick="document.getElementById('addTariffModal').classList.add('hidden')" class="text-gray-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form action="/admin/tariffs" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Slab Name</label>
          <input type="text" name="name" required placeholder="e.g., Domestic Standard" class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Connection Type</label>
          <select name="connectionType" class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50">
            <option value="domestic">Domestic</option>
            <option value="commercial">Commercial</option>
            <option value="industrial">Industrial</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Fixed Charge (₹)</label>
          <input type="number" name="fixedCharge" value="50" required class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Surcharge (%)</label>
          <input type="number" name="surchargePercent" value="5" required class="w-full px-3 py-2.5 bg-surface-900/60 border border-primary-800/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
        </div>
      </div>

      <!-- Dynamic Slab Tiers -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-gray-300">Rate Tiers</label>
          <button type="button" onclick="addSlabRow()" class="text-xs text-primary-400 hover:text-primary-300 font-medium">+ Add Tier</button>
        </div>
        <div id="slabRows" class="space-y-3">
          <!-- Default first row -->
          <div class="grid grid-cols-3 gap-2">
            <input type="number" name="minUnit" placeholder="Min" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
            <input type="number" name="maxUnit" placeholder="Max" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
            <input type="number" name="ratePerUnit" placeholder="Rate (₹)" step="0.01" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
          </div>
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg">
        Create Tariff Slab
      </button>
    </form>
  </div>
</div>

<script>
  // Dynamically add slab tier input rows
  function addSlabRow() {
    const container = document.getElementById('slabRows');
    const row = document.createElement('div');
    row.className = 'grid grid-cols-3 gap-2';
    row.innerHTML = `
      <input type="number" name="minUnit" placeholder="Min" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
      <input type="number" name="maxUnit" placeholder="Max" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
      <input type="number" name="ratePerUnit" placeholder="Rate (₹)" step="0.01" required class="px-3 py-2 bg-surface-900/60 border border-primary-800/30 rounded-lg text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
    `;
    container.appendChild(row);
  }
</script>

<%- include('../partials/footer') %>
