<!-- ==========================================================================
     views/home.ejs — Landing / Home Page
     ==========================================================================
     Public landing page with hero section, feature highlights, and CTAs.
     Also handles 404 display when error404 flag is set.
     ========================================================================== -->

<%- include('partials/header') %>

<% if (typeof error404 !== 'undefined' && error404) { %>
  <!-- 404 Error State -->
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div class="text-8xl font-black bg-gradient-to-r from-primary-500 to-accent-500 bg-clip-text text-transparent mb-4">404</div>
    <h1 class="text-2xl font-bold text-gray-200 mb-2">Page Not Found</h1>
    <p class="text-gray-400 mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="px-6 py-3 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg shadow-primary-500/25">
      Go Home
    </a>
  </div>

<% } else { %>
  <!-- Hero Section -->
  <div class="flex flex-col items-center justify-center min-h-[70vh] text-center">
    <!-- Glowing orb background effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary-600/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-accent-600/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 bg-primary-500/10 border border-primary-500/20 rounded-full text-sm text-primary-300 mb-8">
        <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>PS-7 Assignment — Utility Billing System</span>
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6">
        <span class="text-white">Smart</span>
        <span class="bg-gradient-to-r from-primary-400 via-accent-400 to-primary-400 bg-clip-text text-transparent"> Utility</span>
        <br />
        <span class="text-white">Meter Billing</span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        A complete meter reading, slab-based billing, and payment management system.
        Built for consumers, meter readers, and administrators.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <% if (typeof currentUser === 'undefined' || !currentUser) { %>
          <a href="/auth/register" class="px-8 py-3.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg shadow-primary-500/25 text-lg">
            Get Started
          </a>
          <a href="/auth/login" class="px-8 py-3.5 bg-surface-800 border border-primary-700/30 text-gray-300 font-semibold rounded-xl hover:bg-primary-900/40 hover:text-white transition-all text-lg">
            Sign In
          </a>
        <% } else { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin/dashboard" class="px-8 py-3.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg text-lg">Go to Dashboard</a>
          <% } else if (currentUser.role === 'meter_reader') { %>
            <a href="/meter-reader/meters" class="px-8 py-3.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg text-lg">View Meters</a>
          <% } else { %>
            <a href="/consumer/dashboard" class="px-8 py-3.5 bg-gradient-to-r from-primary-600 to-accent-600 text-white font-semibold rounded-xl hover:from-primary-500 hover:to-accent-500 transition-all shadow-lg text-lg">My Dashboard</a>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Feature Cards -->
    <div class="relative z-10 grid grid-cols-1 sm:grid-cols-3 gap-6 mt-20 w-full max-w-4xl">
      <!-- Feature 1 -->
      <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6 text-center">
        <div class="w-12 h-12 bg-primary-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Slab-Based Billing</h3>
        <p class="text-sm text-gray-400">Auto-calculated bills using configurable tariff slabs with fixed charges.</p>
      </div>

      <!-- Feature 2 -->
      <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6 text-center">
        <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Meter Readings</h3>
        <p class="text-sm text-gray-400">Validated meter readings with rejection of invalid lower values.</p>
      </div>

      <!-- Feature 3 -->
      <div class="card-hover bg-surface-800/60 backdrop-blur border border-primary-800/20 rounded-2xl p-6 text-center">
        <div class="w-12 h-12 bg-accent-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Admin Analytics</h3>
        <p class="text-sm text-gray-400">Dashboard with charts for billing, revenue, and consumption trends.</p>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
